GROQ_API_KEY=your_groq_api_key_here
MODEL_NAME=llama-3.3-70b-versatile
MAX_RETRIES=3
WORKSPACE_DIR=./workspace
REQUEST_TIMEOUT=60
RETRY_BACKOFF_SECONDS=2.0
MAX_REQUESTS_PER_MINUTE=25

